<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Buse & Murat Wedding</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Work+Sans:400,300,600,400italic,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Sacramento" rel="stylesheet">

    <!-- CSS Dosyaları -->
    <link rel="stylesheet" href="~/css/animate.css" />
    <link rel="stylesheet" href="~/css/icomoon.css" />
    <link rel="stylesheet" href="~/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/magnific-popup.css" />
    <link rel="stylesheet" href="~/css/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/css/owl.theme.default.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />

    <script src="~/js/modernizr-2.6.2.min.js"></script>
    <!--[if lt IE 9]>
    <script src="~/js/respond.min.js"></script>
    <![endif]-->
</head>
<body>

    <!-- Menü -->
    <nav class="fh5co-nav" role="navigation">
        <div class="container">
            <div class="row">
                <div class="col-xs-2">
                    <div id="fh5co-logo">
                        <a href="@Url.Action("Index", "Home")">Wedding<strong>.</strong></a>
                    </div>
                </div>
                <div class="col-xs-10 text-right menu-1">
                    <ul>
                        <li><a href="/Contact/Index" onclick="return window.location.href='/Contact/Index';">Contact</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Sayfa İçeriği -->
    @RenderBody()

    <!-- Footer -->
    <footer id="fh5co-footer" role="contentinfo">
        <div class="container">
            <div class="row copyright">
                <div class="col-md-12 text-center">
                    <p>
                        <small class="block">&copy; 2025 Buse & Murat. Tüm Hakları Saklıdır.</small>
                        <small class="block">Design by <a href="http://freehtml5.co/" target="_blank">FREEHTML5.co</a></small>
                    </p>
                    <p>
                        <ul class="fh5co-social-icons">
                            <li><a href="#"><i class="icon-twitter"></i></a></li>
                            <li><a href="#"><i class="icon-facebook"></i></a></li>
                            <li><a href="#"><i class="icon-linkedin"></i></a></li>
                            <li><a href="#"><i class="icon-dribbble"></i></a></li>
                        </ul>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Yukarı Çık -->
    <div class="gototop js-top">
        <a href="#" class="js-gotop"><i class="icon-arrow-up"></i></a>
    </div>

    <!-- JS Dosyaları -->
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/jquery.easing.1.3.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.waypoints.min.js"></script>
    <script src="~/js/owl.carousel.min.js"></script>
    <script src="~/js/jquery.countTo.js"></script>
    <script src="~/js/jquery.stellar.min.js"></script>
    <script src="~/js/jquery.magnific-popup.min.js"></script>
    <script src="~/js/magnific-popup-options.js"></script>
    <script src="~/js/simplyCountdown.js"></script>
    <script src="~/js/main.js"></script>

    <!-- Geri Sayım -->
    <script src="~/js/simplyCountdown.js"></script>
    <script>
        simplyCountdown('.simply-countdown-one', {
            year: 2025,
            month: 7,
            day: 5,
            enableUtc: false
        });
    </script>


    <!-- Hata Vermesin Diye -->
    @RenderSection("Scripts", required: false)

</body>
</html>
